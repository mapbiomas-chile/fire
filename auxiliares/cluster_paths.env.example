# =============================================================================
# Auxiliares — export masked rasters for GEE
#
#   cp auxiliares/cluster_paths.env.example auxiliares/cluster_paths.env
#   nano auxiliares/cluster_paths.env
#   source auxiliares/cluster_paths.env
#   bash auxiliares/run_to_gee_pipeline.sh
# =============================================================================

export PYTHON="/path/to/your/env/bin/python"
export REPO_ROOT="/path/to/fire"

# Post-filter rasters and final polygon layer (must pair 1:1 by tile stem)
export WORK_ROOT="/path/to/classification_YYYYMMDD/filtering_work"
export CLASSIFIED_INPUT_DIR="${WORK_ROOT}/classified_filtered"
export POLYGON_INPUT_DIR="${WORK_ROOT}/polygons_filtered_min20ha_p25"

# Cluster output (not in git)
export TO_GEE_ROOT="/path/to/toGEE"
export OUTPUT_BY_TILE="${TO_GEE_ROOT}/by_tile"
export OUTPUT_BY_YEAR="${TO_GEE_ROOT}/by_year_chile"
export MERGE_OUTPUT_STEM="chile_burn_p25"

export MASK_WORKERS=4
export POLYGON_SUFFIX=auto
export STEPS=all
