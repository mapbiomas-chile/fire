# NLHPC leftraru — vectorización + post-filter classification_20260619
#
# Criterios en evaluación:
#   - Per-tile: polygonize SIN sieve raster
#   - Filtro área vector: >= 20 ha → histogramas → p5/p10/p25/elbow → aplicar una regla
#   - Nacional: merge anual + sieve 112 px (~1 ha) + fragmentos 112 px + agrupación 200 m
#
#   cp vectorize/cluster_paths.20260619.env.leftraru vectorize/cluster_paths.env
#   cp filtering/cluster_paths.20260619.env.leftraru filtering/cluster_paths.env
#   source vectorize/cluster_paths.env
#
# Per-tile (nodo login):
#   bash vectorize/run_vectorize_pipeline.sh
#
# Filtro área polígonos (nodo login):
#   bash filtering/run_polygon_area_pipeline.sh
#
# Nacional (nodo login):
#   bash vectorize/run_vectorize_national_pipeline.sh
#
# Todo el post-filter en secuencia (login):
#   bash vectorize/run_post_filter_pipeline.sh
#
# Opcional SLURM: run_vectorize_pipeline_slurm.sh, run_vectorize_national_pipeline_slurm.sh

export PYTHON="/home/flepin/.conda/envs/mb_fuego/bin/python"
export REPO_ROOT="/home/flepin/fire"

export WORK_ROOT="/home/flepin/classification_20260619/filtering_work"
export VECTORIZE_INPUT_DIR="${WORK_ROOT}/classified_filtered"
export VECTORIZE_OUTPUT_DIR="${WORK_ROOT}/polygons"
export VECTORIZE_WORKERS=4
export VECTORIZE_MASK_VALUE=1
export VECTORIZE_CONNECTIVITY=8
export VECTORIZE_STATS_JSON="${WORK_ROOT}/logs/vectorize_stats.json"

# Per-tile: sin sieve raster (umbral vectorial vía histogramas / P25)
export VECTORIZE_SKIP_SIEVE=1
# Alternativa MapBiomas clásica (~1 ha antes de polygonize):
# export VECTORIZE_SKIP_SIEVE=0
# export VECTORIZE_SIEVE_MIN_PIXELS=112

# --- Vectorización nacional ---
export VECTORIZE_NATIONAL_WORK_ROOT="${WORK_ROOT}/national_vector"
export VECTORIZE_NATIONAL_GROUP_DISTANCE_M=200
export VECTORIZE_NATIONAL_FROM_YEAR=2013
export VECTORIZE_NATIONAL_TO_YEAR=2025
export VECTORIZE_NATIONAL_MERGE_WORKERS=2
export VECTORIZE_NATIONAL_STATS_JSON="${VECTORIZE_NATIONAL_WORK_ROOT}/logs/national_vectorize_stats.json"
export VECTORIZE_NATIONAL_SIEVE_MIN_PIXELS=112
export VECTORIZE_NATIONAL_FRAGMENT_MIN_PIXELS=112

# --- Filtro de área en polígonos (filtering/run_polygon_area_pipeline.sh) ---
# Paso 1: corte fijo >= 20 ha. Paso 2: histogramas + p5/p10/p25/elbow sobre lo que queda.
export POLYGON_INPUT_DIR="${WORK_ROOT}/polygons"
export POLYGON_PRE_FILTER_HA=20
export POLYGON_PRE_FILTER_DIR="${WORK_ROOT}/polygons_min20ha"
export POLYGON_HISTOGRAMS_DIR="${WORK_ROOT}/histogramas_area_min20ha"
export POLYGON_THRESHOLDS_DIR="${WORK_ROOT}/thresholds_area_min20ha"
export POLYGON_THRESHOLD_RULE=p25
export POLYGON_PER_REGION_YEAR=1
export POLYGON_STEPS=all
# Salida del paso 2 (cambiar regla sin recalcular umbrales: STEPS=filter POLYGON_THRESHOLD_RULE=p10)
# POLYGON_FILTERED_GPKG y POLYGON_FILTERED_DIR se derivan de POLYGON_THRESHOLD_RULE si no se exportan
