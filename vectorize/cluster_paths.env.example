# =============================================================================
# Configuración del pipeline auxiliar de vectorización (una copia por usuario)
#
#   cp vectorize/cluster_paths.env.example vectorize/cluster_paths.env
#   nano vectorize/cluster_paths.env
#   source vectorize/cluster_paths.env
#   bash vectorize/run_vectorize_pipeline.sh
#
# No commitear cluster_paths.env (está en .gitignore).
# =============================================================================

# --- Python con geopandas + rasterio ---
export PYTHON="/path/to/your/env/bin/python"

# --- Raíz del trabajo (misma que filtering; donde está classified_filtered/) ---
export WORK_ROOT="/path/to/filtering_work"

# --- Entrada / salida ---
export VECTORIZE_INPUT_DIR="${WORK_ROOT}/classified_filtered"
export VECTORIZE_OUTPUT_DIR="${WORK_ROOT}/polygons"

# --- Paralelismo ---
# Nodo login: 2–4. SLURM (run_vectorize_pipeline_slurm.sh): 22 por defecto.
export VECTORIZE_WORKERS=4

# --- Opciones ---
export VECTORIZE_MASK_VALUE=1
export VECTORIZE_CONNECTIVITY=8
export VECTORIZE_SIEVE_MIN_PIXELS=112
# export VECTORIZE_SKIP_SIEVE=1
# export VECTORIZE_NAME_CONTAINS=b14_chile_r1
# export VECTORIZE_MERGED_GPKG="${WORK_ROOT}/polygons/all_burns.gpkg"
export VECTORIZE_STATS_JSON="${WORK_ROOT}/logs/vectorize_stats.json"

# --- Vectorización nacional (merge por año + agrupación espacial) ---
# bash vectorize/run_vectorize_national_pipeline.sh
export VECTORIZE_NATIONAL_WORK_ROOT="${WORK_ROOT}/national_vector"
export VECTORIZE_NATIONAL_GROUP_DISTANCE_M=200
export VECTORIZE_NATIONAL_FROM_YEAR=2013
export VECTORIZE_NATIONAL_TO_YEAR=2025
export VECTORIZE_NATIONAL_MERGE_WORKERS=2
# export VECTORIZE_NATIONAL_KEEP_RAW=1
export VECTORIZE_NATIONAL_STATS_JSON="${VECTORIZE_NATIONAL_WORK_ROOT}/logs/national_vectorize_stats.json"

# Sieve: drop connected burn components smaller than N pixels (after yearly merge)
export VECTORIZE_NATIONAL_SIEVE_MIN_PIXELS=112
# export VECTORIZE_NATIONAL_SIEVE_MIN_HA=1   # optional ha rule instead of pixels
# export VECTORIZE_NATIONAL_SKIP_SIEVE=1

# Drop small polygon fragments before 200 m grouping (same pixel rule as sieve)
export VECTORIZE_NATIONAL_FRAGMENT_MIN_PIXELS=112
# export VECTORIZE_NATIONAL_FRAGMENT_MIN_HA=1   # legacy ha rule
# export VECTORIZE_NATIONAL_SKIP_FRAGMENT_FILTER=1

# =============================================================================
# Ejemplo leftraru:
#
# export PYTHON="/home/flepin/.conda/envs/mb_fuego/bin/python"
# export WORK_ROOT="/home/flepin/classification_20260528/filtering_work"
# export VECTORIZE_INPUT_DIR="${WORK_ROOT}/classified_filtered"
# export VECTORIZE_OUTPUT_DIR="${WORK_ROOT}/polygons"
# =============================================================================
