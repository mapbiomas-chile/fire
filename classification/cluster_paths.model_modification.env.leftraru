# =============================================================================
# NLHPC leftraru — entrenamiento modelos mejorados (rama feature/model_modification)
#
# Uso (MLP TensorFlow):
#   cp classification/cluster_paths.model_modification.env.leftraru classification/cluster_paths.env
#   source classification/cluster_paths.env
#   sbatch classification/run_train_fire_model_slurm.sh
#
# Uso (XGBoost benchmark):
#   export TRAIN_BACKEND=xgboost
#   sbatch classification/run_train_fire_model_slurm.sh
# =============================================================================

export REPO_ROOT="/home/flepin/fire"
export PYTHON="/home/flepin/.conda/envs/mb_fuego/bin/python"

export COUNTRY=chile
# TRAIN_REGION / TRAIN_VERSION: set per job (campaign loop or manual export).
# Do not hardcode here — it breaks the 7-model campaign.

export TRAINING_SAMPLES_DIR="/home/flepin/samples_col1"
export MODELS_DIR="/home/flepin/models_col1_20260618"

# Entrenamiento mejorado (defaults del nuevo train_fire_model.py)
export TRAIN_VALIDATION_SPLIT=by_file
export TRAIN_LOSS=weighted
export TRAIN_OVERSAMPLE_BURNED=1
export TRAIN_METRIC=f1
export TRAIN_SPATIAL_WINDOW_SIZE=5
export TRAIN_N_ITER=7000
export TRAIN_BATCH_SIZE=1000
export TRAIN_SEED=42

# Límites de RAM: subsamplea píxeles si una región tiene muchas muestras (evita OOM)
export TRAIN_MAX_TRAINING_PIXELS=2000000
export TRAIN_MAX_VALIDATION_PIXELS=500000
export TRAIN_INFERENCE_BLOCK_SIZE=500000

# Muestras en disco: samples_fire_v1_* (token v1 en nombre de archivo)
export SAMPLE_VERSION=v1

# Campaña completa (7 modelos, 1 solo job Slurm de 1 h):
#   bash classification/run_train_chile_campaign.sh --dry-run
#   bash classification/run_train_chile_campaign.sh

# TRAIN_BACKEND: tensorflow (default) | xgboost
export TRAIN_BACKEND=tensorflow
