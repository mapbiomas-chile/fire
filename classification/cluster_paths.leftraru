# =============================================================================
# NLHPC leftraru — clasificación por región con versión de modelo automática
#
# Reglas de modelo:
#   r2:  v1 para 2013–2025
#   r1, r4, r6: v1 para 2013–2018, v2 para 2019–2025
#
# Uso:
#   cp classification/cluster_paths.leftraru classification/cluster_paths.env
#   # editar REGION, START_YEAR, END_YEAR si hace falta
#   source classification/cluster_paths.env
#   sbatch classification/run_classify_region_slurm.sh
# =============================================================================

export REGION=r2
export START_YEAR=2013
export END_YEAR=2025

# Dejar MODEL_VERSION vacío y activar auto (o fijar MODEL_VERSION=v1 para forzar una versión).
unset MODEL_VERSION
export AUTO_MODEL_VERSION_BY_YEAR=1

export MOSAIC_DIR="/home/flepin/mosaics_cog"
export MODEL_DIR="/home/flepin/models_col1"
export OUTPUT_DIR="/home/flepin/classification_20260616"
export REPO_ROOT="/home/flepin/fire"

export SATELLITE=b14
export COUNTRY=chile
export COLLECTION_NAME=col1

export PYTHON="/home/flepin/.conda/envs/mb_fuego/bin/python"
export BLOCK_SIZE=40000000

# Opcional: override del umbral calibrado en hyperparameters JSON
# export DECISION_THRESHOLD=0.45
# export OPENING_FILTER_SIZE=2
# export CLOSING_FILTER_SIZE=4
