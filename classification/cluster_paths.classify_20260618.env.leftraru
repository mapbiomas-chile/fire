# =============================================================================
# NLHPC leftraru — clasificación serie completa 2013–2025 (modelos 20260618)
#
# Modelos: /home/flepin/models_col1_20260618
# Salida:  /home/flepin/classification_20260618
#
# Reglas auto v1/v2:
#   r2:  v1 todos los años
#   r1, r4, r6: v1 (2013–2018), v2 (2019–2025)
#
# Uso:
#   cp classification/cluster_paths.classify_20260618.env.leftraru classification/cluster_paths.env
#   source classification/cluster_paths.env
#   bash classification/run_classify_chile_campaign.sh
# =============================================================================

export REPO_ROOT="/home/flepin/fire"
export PYTHON="/home/flepin/.conda/envs/mb_fuego/bin/python"

export START_YEAR=2013
export END_YEAR=2025

# REGION se define por job (r1, r2, r4, r6) — no fijar aquí
unset MODEL_VERSION
export AUTO_MODEL_VERSION_BY_YEAR=1

export MOSAIC_DIR="/home/flepin/mosaics_cog"
export MODEL_DIR="/home/flepin/models_col1_20260618"
export OUTPUT_DIR="/home/flepin/classification_20260618"

export SATELLITE=b14
export COUNTRY=chile
export COLLECTION_NAME=col1
export BLOCK_SIZE=40000000

# ~10–15 min/año × 13 años ≈ 2.5–3 h por región
export CLASSIFY_WALLTIME=03:30:00

# Usar umbral calibrado del JSON (no exportar DECISION_THRESHOLD salvo override)
