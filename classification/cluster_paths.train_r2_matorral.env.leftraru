# NLHPC leftraru — entrenar r2 v1 solo con 8 muestras matorral
#
#   cp classification/cluster_paths.train_r2_matorral.env.leftraru classification/cluster_paths.env
#   source classification/cluster_paths.env
#   bash classification/run_train_r2_matorral.sh
#   # o: sbatch classification/run_train_fire_model_slurm.sh

export REPO_ROOT="/home/flepin/fire"
export PYTHON="/home/flepin/.conda/envs/mb_fuego/bin/python"

export TRAIN_REGION=r2
export TRAIN_VERSION=v1
export COUNTRY=chile
export SAMPLE_VERSION=v1

export TRAINING_SAMPLES_DIR="/home/flepin/samples_col1"
export TRAINING_SAMPLE_LIST="${REPO_ROOT}/classification/training_samples_r2_matorral_v1.txt"

# Checkpoint aislado (no pisa el r2 de la campaña de 7 modelos hasta validar)
export MODELS_DIR="/home/flepin/models_col1_r2_matorral"

export TRAIN_VALIDATION_SPLIT=by_file
export TRAIN_LOSS=weighted
export TRAIN_OVERSAMPLE_BURNED=1
export TRAIN_METRIC=f1
export TRAIN_SPATIAL_WINDOW_SIZE=5
export TRAIN_N_ITER=7000
export TRAIN_BATCH_SIZE=1000
export TRAIN_SEED=42
export TRAIN_MAX_TRAINING_PIXELS=2000000
export TRAIN_MAX_VALIDATION_PIXELS=500000
export TRAIN_INFERENCE_BLOCK_SIZE=500000
export TRAIN_BACKEND=tensorflow

# Lista explícita: no usar filtro por años en el nombre del sample
unset SAMPLE_START_YEAR
unset SAMPLE_END_YEAR
