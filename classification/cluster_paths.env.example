# =============================================================================
# Configuración local para reprocesar clasificaciones por región (NLHPC / local)
#
#   cp classification/cluster_paths.env.example classification/cluster_paths.env
#   nano classification/cluster_paths.env
#   source classification/cluster_paths.env
#   sbatch classification/run_classify_region_slurm.sh
#
# No commitear cluster_paths.env (está en .gitignore).
# =============================================================================

# --- Región y años a clasificar ---
export REGION=r2
export START_YEAR=2019
export END_YEAR=2025

# --- Modelo ---
# Convención: col1_chile_<MODEL_VERSION>_<REGION>_rnn_lstm_ckpt
export MODEL_VERSION=v2
# Opcional: nombre completo del checkpoint (sin extensión). Si se define, ignora MODEL_VERSION.
# export MODEL_NAME=col1_chile_v2_r2_rnn_lstm_ckpt

# --- Rutas (ajustar usuario) ---
export MOSAIC_DIR="${HOME}/mosaics_cog"
export MODEL_DIR="${HOME}/models_col1"
export OUTPUT_DIR="${HOME}/classi_v2/${REGION}_${MODEL_VERSION}"
export REPO_ROOT="${HOME}/fire"

# --- Mosaicos ---
export SATELLITE=b14
export COUNTRY=chile
export COLLECTION_NAME=col1

# --- Python (Conda mb_fuego en NLHPC) ---
export PYTHON="${HOME}/.conda/envs/mb_fuego/bin/python"

# --- Inferencia ---
export BLOCK_SIZE=40000000
