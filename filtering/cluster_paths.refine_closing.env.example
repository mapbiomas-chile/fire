# =============================================================================
# Config for run_refine_closing_pipeline.sh (pilot — internal fill / closing)
# =============================================================================

export PYTHON="/path/to/your/env/bin/python"
export WORK_ROOT="/path/to/filtering_work"
export REFINE_INPUT_DIR="${WORK_ROOT}/classified_filtered"
export REFINE_OUTPUT_DIR="${WORK_ROOT}/classified_refined"

# fill_holes = enclosed internal gaps only, outer boundary unchanged (default)
# closing      = morphological closing (also moves outer edge)
# both           = fill_holes then closing
export REFINE_METHOD="fill_holes"
export REFINE_OUTPUT_SUFFIX="_filled"

# Only used when REFINE_METHOD is closing or both:
export CLOSING_SIZE=2
export CLOSING_ITERATIONS=1

# export REFINE_NAME_CONTAINS=b14_chile_r1
export WORKERS=4
