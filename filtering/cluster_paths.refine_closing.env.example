# =============================================================================
# Config for run_refine_closing_pipeline.sh (pilot — closing only)
#
#   cp filtering/cluster_paths.refine_closing.env.example filtering/cluster_paths.env
#   nano filtering/cluster_paths.env
#   source filtering/cluster_paths.env
#   bash filtering/run_refine_closing_pipeline.sh
#
# You can also add these variables to an existing cluster_paths.env used for
# the LULC+temporal pipeline (same file, different bash entrypoint).
# =============================================================================

export PYTHON="/path/to/your/env/bin/python"

# Root for logs/ (output dir can be separate)
export WORK_ROOT="/path/to/filtering_work"

# Input: output of LULC + temporal filter (e.g. *_first_burn_year.tif)
export REFINE_INPUT_DIR="${WORK_ROOT}/classified_filtered"

# Output: refined rasters (*_closed.tif)
export REFINE_OUTPUT_DIR="${WORK_ROOT}/classified_refined"

# Morphology (gentle defaults)
export CLOSING_SIZE=2
export CLOSING_ITERATIONS=1
export REFINE_OUTPUT_SUFFIX="_closed"

# Optional: limit to pilot tiles
# export REFINE_NAME_CONTAINS=141228

export WORKERS=4

# =============================================================================
# Example (flepin / classification_20260602):
#
# export PYTHON="/home/flepin/.conda/envs/mb_fuego/bin/python"
# export WORK_ROOT="/home/flepin/classification_20260602/filtering_work"
# export REFINE_INPUT_DIR="${WORK_ROOT}/classified_filtered"
# export REFINE_OUTPUT_DIR="${WORK_ROOT}/classified_refined"
# export REFINE_NAME_CONTAINS=141228
# =============================================================================
