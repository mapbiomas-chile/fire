# =============================================================================
# Comparación: agricultura estricta + relleno post-LULC
#
# Baseline (ya corrido): filtering_work/
#   LULC_STABILITY_WINDOW=4, sin FILL_AGRICULTURAL_HOLES
#
# Variante nueva: filtering_work_20260616/
#   LULC_AGRICULTURE_STABILITY_WINDOW=1  (agro si el año Y es clase 15)
#   FILL_AGRICULTURAL_HOLES=1             (rellena huecos ag encerrados en cicatrices)
#
#   cp filtering/cluster_paths.ag_strict.env.example filtering/cluster_paths.env
#   # Copiar LULC_STACK y PYTHON desde tu cluster_paths.env anterior
#   source filtering/cluster_paths.env
#   bash filtering/run_filtering_pipeline.sh
# =============================================================================

export PYTHON="/home/flepin/.conda/envs/mb_fuego/bin/python"

# Mismo stack LULC que filtering_work (ajusta si difiere en tu máquina)
export LULC_STACK="/home/flepin/lulc_collection02/lulc_2025_subset.tif"
export START_YEAR_BAND1=2000

# Clasificados crudos (carpeta con *_classified.tif)
export CLASSIFIED_DIR="/home/flepin/classification_20260609"

# Salida de la prueba comparativa
export WORK_ROOT="/home/flepin/classification_20260609/filtering_work_20260616"
export FILTER_OUTPUT_DIR="${WORK_ROOT}/classified_filtered"

export FROM_YEAR=2013
export TO_YEAR=2025
export LULC_TO_YEAR=2024
export COPY_MASK_2025_FROM_2024=1

# Pastura / rio / infra: ventana 4 años (como baseline)
export LULC_STABILITY_WINDOW=4
# Agricultura: año Y solo (estricto)
export LULC_AGRICULTURE_STABILITY_WINDOW=1

export FILL_HOLES=1
export MAX_HOLE_AREA=0
export FILL_AGRICULTURAL_HOLES=1
export AGRICULTURE_MASKS_DIR="${WORK_ROOT}/mascaras/by_year"

export SKIP_MIN_PATCH_SIEVE=1
export WORKERS=8
export STEPS="all"
