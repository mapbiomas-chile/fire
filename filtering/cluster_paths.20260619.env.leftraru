export POLYGON_PRE_FILTER_HA=20
export POLYGON_PRE_FILTER_DIR="${WORK_ROOT}/polygons_min20ha"
export POLYGON_HISTOGRAMS_DIR="${WORK_ROOT}/histogramas_area_min20ha"
export POLYGON_THRESHOLDS_DIR="${WORK_ROOT}/thresholds_area_min20ha"
export POLYGON_THRESHOLD_RULE=p25
export POLYGON_PER_REGION_YEAR=1
export POLYGON_STEPS=all
