# Copy to cluster_paths.env and adjust paths (do not commit secrets).
# Source before running the pipeline:
#   source filtering/cluster_paths.env
#
# cp filtering/cluster_paths.env.example filtering/cluster_paths.env

# --- Repositorio y Python ---
export REPO_ROOT="/home/flepin/fire"
export PYTHON="/home/flepin/.conda/envs/mb_fuego/bin/python"

# --- Entradas ---
# Un solo GeoTIFF multibanda (una banda = un año). No usar .vrt.
# Banda 1 = START_YEAR_BAND1.
export LULC_STACK="/home/flepin/lulc_collection02/lulc_chile_collection02_1999_2025.tif"
export START_YEAR_BAND1=1999

# Clasificados de área quemada (un GeoTIFF por tile, nombre con año 20xx)
export CLASSIFIED_DIR="/home/flepin/classi_v2"

# --- Directorio de trabajo (salidas) ---
export WORK_ROOT="/home/flepin/filtering_work"

# --- Años a procesar ---
export FROM_YEAR=2013
export TO_YEAR=2025

# --- Paralelismo ---
export WORKERS=22

# --- Pasos del pipeline (coma-separados o "all") ---
# masks_accumulated,masks_yearly,masks_total,filter
export STEPS="all"
