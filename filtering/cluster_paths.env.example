# =============================================================================
# Configuración local del pipeline de filtrado (una copia por usuario/máquina)
#
#   cp filtering/cluster_paths.env.example filtering/cluster_paths.env
#   nano filtering/cluster_paths.env    # editar rutas abajo
#   source filtering/cluster_paths.env
#   bash filtering/run_filtering_pipeline.sh
#
# No commitear cluster_paths.env (está en .gitignore).
# =============================================================================

# --- Repositorio (opcional; por defecto se detecta desde el script) ---
# export REPO_ROOT="/path/to/fire"

# --- Python con numpy + rasterio (Conda, venv, etc.) ---
export PYTHON="/path/to/your/env/bin/python"

# --- Entradas ---
# GeoTIFF multibanda MapBiomas: una banda = un año. No usar .vrt.
export LULC_STACK="/path/to/lulc_collection02/lulc_stack.tif"
export START_YEAR_BAND1=2000

# Clasificados en bruto del modelo (un .tif por tile; nombre con año 20xx)
export CLASSIFIED_DIR="/path/to/classification_YYYYMMDD"

# --- Salidas (raíz de todo el trabajo de filtrado) ---
export WORK_ROOT="/path/to/filtering_work"

# --- Años ---
export FROM_YEAR=2013
export TO_YEAR=2025
export LULC_TO_YEAR=2024
export COPY_MASK_2025_FROM_2024=1

# --- Paralelismo ---
# Nodo login: 2–4. Nodo SLURM con muchos cores: subir WORKERS en el job.
export WORKERS=4

# --- Pasos (coma-separados o "all") ---
# masks_accumulated, masks_yearly, masks_total, filter
export STEPS="all"

# --- Salida del filtrado (opcional; por defecto bajo WORK_ROOT) ---
export FILTER_OUTPUT_DIR="${WORK_ROOT}/classified_filtered"
# export KEEP_TEMPORAL_INTERMEDIATE=1
# export KEEP_FILL_INTERMEDIATE=1
# export FILTER_NAME_CONTAINS=141228
# export TEMPORAL_SPATIAL_MERGE=1

# --- Relleno interno (paso 3 del pipeline; integrado en STEPS=filter) ---
export FILL_HOLES=1
export MAX_HOLE_AREA=0
# export SKIP_FILL_HOLES=1

# Standalone refine only (legacy): run_refine_closing_pipeline.sh +
# cluster_paths.refine_closing.env.example

# Vectorización: pipeline separado en vectorize/ (después del filtrado).
#   cp vectorize/cluster_paths.env.example vectorize/cluster_paths.env

# =============================================================================
# Ejemplo (reemplazar USER y rutas reales):
#
# export PYTHON="/home/USER/.conda/envs/mb_fuego/bin/python"
# export LULC_STACK="/home/USER/lulc_collection02/lulc_2025_subset.tif"
# export CLASSIFIED_DIR="/home/USER/classification_20260602"
# export WORK_ROOT="/home/USER/classification_20260602/filtering_work"
# export STEPS="filter"
# =============================================================================
