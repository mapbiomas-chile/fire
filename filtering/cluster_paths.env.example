# Plantilla de configuración para run_filtering_pipeline.sh
#
#   cp filtering/cluster_paths.env.example filtering/cluster_paths.env
#   source filtering/cluster_paths.env
#   bash filtering/run_filtering_pipeline.sh
#
# No commitear cluster_paths.env (está en .gitignore).

# --- Repositorio y Python ---
export REPO_ROOT="/home/flepin/fire"
export PYTHON="/home/flepin/.conda/envs/mb_fuego/bin/python"

# --- Entradas ---
# Un solo GeoTIFF multibanda (.tif). No usar .vrt. Banda 1 = START_YEAR_BAND1.
export LULC_STACK="/home/flepin/lulc_collection02/lulc_2025_subset_mosaic_bbox_without_region5.tif"
export START_YEAR_BAND1=2000

# Clasificados de área quemada (un GeoTIFF por tile; nombre con año 20xx)
export CLASSIFIED_DIR="/home/flepin/classification_20260528"

# --- Directorio de trabajo (salidas) ---
export WORK_ROOT="/home/flepin/filtering_work_local"

# --- Años ---
export FROM_YEAR=2013
export TO_YEAR=2025
export LULC_TO_YEAR=2024
export COPY_MASK_2025_FROM_2024=1

# --- Paralelismo ---
# Login node: 2–4. Nodo SLURM: 22 (ver run_filtering_pipeline_slurm.sh).
export WORKERS=4

# --- Pasos (coma-separados o "all") ---
# masks_accumulated, masks_yearly, masks_total, filter
export STEPS="all"

# --- Salida del filtrado ---
export FILTER_OUTPUT_DIR="${WORK_ROOT}/classified_filtered"
# export KEEP_LULC_INTERMEDIATE=1
# export FILTER_NAME_CONTAINS=141228
# export TEMPORAL_SPATIAL_MERGE=1
